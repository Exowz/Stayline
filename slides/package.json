{
  "name": "stayline-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "cd .. && .venv/bin/python slides/scripts/build_data.py",
    "notes": "cd .. && .venv/bin/python slides/scripts/build_slides.py",
    "predev": "npm run data && npm run notes",
    "prebuild": "npm run data && npm run notes",
    "preexport": "npm run data && npm run notes",
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md",
    "export": "slidev export slides.md --output stayline-defence.pdf",
    "export-png": "slidev export slides.md --format png --output export-png"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/onest": "5.2.8",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0"
  },
  "devDependencies": {
    "playwright-chromium": "1.48.2"
  }
}
